def plot_learning_curve_with_external(
    estimator,
    title,
    X_train,
    y_train,
    X_test,
    y_test,
    X_val1,
    y_val1,
    X_val2,
    y_val2,
    cv=None,
    n_jobs=1,
    train_sizes=np.linspace(0.1, 1.0, 5),
    fig_size=(7.2, 5.2),
    ax_rect=(0.12, 0.16, 0.78, 0.68),
    title_wrap=60,
    output_dir=output_dir
):
    fig = plt.figure(figsize=fig_size)
    ax = fig.add_axes(ax_rect)

    full_title = f"Learning Curve For Prelaryngeal Lymph Node Metastasis: {title}"
    full_title = "\n".join(textwrap.wrap(full_title, width=title_wrap))
    fig.text(0.5, 0.93, full_title, ha='center', va='top', fontsize=12, fontweight='bold')

    ax.set_xlabel("Training examples")
    ax.set_ylabel("ROC AUC")

    train_sizes_abs, train_scores, test_scores = learning_curve(
        estimator=estimator,
        X=X_train,
        y=y_train,
        cv=cv,
        n_jobs=n_jobs,
        train_sizes=train_sizes,
        scoring='roc_auc',
        shuffle=True,
        random_state=33
    )

    train_mean = np.mean(train_scores, axis=1)
    train_std = np.std(train_scores, axis=1)
    test_mean = np.mean(test_scores, axis=1)
    test_std = np.std(test_scores, axis=1)

    rng = np.random.RandomState(33)
    shuffled_idx = rng.permutation(len(X_train))

    if isinstance(X_train, pd.DataFrame):
        X_train_shuffled = X_train.iloc[shuffled_idx].reset_index(drop=True)
    else:
        X_train_shuffled = pd.DataFrame(X_train).iloc[shuffled_idx].reset_index(drop=True)

    if isinstance(y_train, pd.Series):
        y_train_shuffled = y_train.iloc[shuffled_idx].reset_index(drop=True)
    else:
        y_train_shuffled = pd.Series(y_train).iloc[shuffled_idx].reset_index(drop=True)

    val1_scores = []
    val2_scores = []

    for n in train_sizes_abs:
        X_sub = X_train_shuffled.iloc[:n, :]
        y_sub = y_train_shuffled.iloc[:n]

        estimator.fit(X_sub, y_sub)

        p1 = get_prob(estimator, X_val1)
        p2 = get_prob(estimator, X_val2)

        val1_scores.append(roc_auc_score(y_val1, p1))
        val2_scores.append(roc_auc_score(y_val2, p2))

    val1_scores = np.array(val1_scores)
    val2_scores = np.array(val2_scores)

    # ===== 绘图 =====
    ax.grid(True)

    ax.fill_between(train_sizes_abs, train_mean-train_std, train_mean+train_std,
                    alpha=0.1, color="red")
    ax.fill_between(train_sizes_abs, test_mean-test_std, test_mean+test_std,
                    alpha=0.1, color="green")

    v1_std, v2_std = np.std(val1_scores), np.std(val2_scores)
    ax.fill_between(train_sizes_abs, val1_scores-v1_std, val1_scores+v1_std,
                    alpha=0.1, color="blue")
    ax.fill_between(train_sizes_abs, val2_scores-v2_std, val2_scores+v2_std,
                    alpha=0.1, color="skyblue")

    ax.plot(train_sizes_abs, train_mean, 'o-', color='red',
            label=f"Train score(mean ROC AUC={train_mean[-1]:.3f})")
    ax.plot(train_sizes_abs, test_mean, 'o-', color='green',
            label=f"Test score (mean ROC AUC={test_mean[-1]:.3f})")
    ax.plot(train_sizes_abs, val1_scores, 'o-', color='blue',
            label=f"Validation1 score (mean ROC AUC={val1_scores.mean():.3f})")
    ax.plot(train_sizes_abs, val2_scores, 'o-', color='skyblue',
            label=f"Validation2 score (mean ROC AUC={val2_scores.mean():.3f})")

    for i, n in enumerate(train_sizes_abs):
        ax.text(n, train_mean[i], f'{train_mean[i]:.3f}', fontsize=8, color='red')
        ax.text(n, test_mean[i],  f'{test_mean[i]:.3f}',  fontsize=8, color='green')
        ax.text(n, val1_scores[i], f'{val1_scores[i]:.3f}', fontsize=8, color='blue')
        ax.text(n, val2_scores[i], f'{val2_scores[i]:.3f}', fontsize=8, color='skyblue')

    ax.legend(loc='best', fontsize=8)

    safe_title = sanitize_filename(title)

    formats = ['tiff']
    dpis = [50]
    for fmt in formats:
        for dpi in dpis:
            fig.savefig(
                os.path.join(output_dir, f'Figure5-Prelaryngeal-LC-{safe_title}_{dpi}dpi.{fmt}'),
                format=fmt,
                dpi=dpi,
                bbox_inches='tight'
