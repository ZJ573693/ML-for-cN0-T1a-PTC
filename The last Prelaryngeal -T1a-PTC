                os.path.join(output_dir, f'Figure5-Prelaryngeal-LC-{safe_title}.pdf'),
                format='pdf',
                dpi=1200,
                bbox_inches='tight'
            )
            fig.savefig(
                os.path.join(output_dir, f'Figure5-Prelaryngeal-LC-{safe_title}.svg'),
                format='svg',
                dpi=1200,
                bbox_inches='tight'
            )

