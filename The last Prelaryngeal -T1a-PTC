import shap
import matplotlib as mpl
import matplotlib.pyplot as plt

from sklearn.model_selection import train_test_split
from sklearn.preprocessing import MinMaxScaler
from xgboost import XGBClassifier

mpl.rcParams['pdf.fonttype'] = 42
mpl.rcParams['ps.fonttype'] = 42
mpl.rcParams['svg.fonttype'] = 'none'
mpl.rcParams['font.family'] = 'Arial'
mpl.rcParams['axes.unicode_minus'] = False

# 输出目录
output_dir = 'D:/5.ptmc/2.结果/2.py的结果/3.SHAP可视化'
os.makedirs(output_dir, exist_ok=True)

# 加载数据
train_data = pd.read_csv('D:/5.ptmc/2.结果/2.py的结果/1.补充材料1-筛选变量/0.数据/1.总H编码后_插补矫正后.csv')

# 提取特征和目标
feature_cols = ['Sex', 'Extrathyroidal extension', 'Tumor border', 'Aspect ratio', 'Calcification', 'Hashimoto', 'Location', 'Mulifocality', 'age', 'size']
target_col = 'Prelaryngeal LNM'

X = train_data[feature_cols].copy()
y = train_data[target_col].copy()

# 数值变量标准化
num_cols = ['age', 'size']
cat_cols = ['Sex', 'Extrathyroidal extension', 'Tumor border', 'Aspect ratio', 'Calcification', 'Hashimoto', 'Location', 'Mulifocality']

# 先划分训练集和测试集，再做标准化，避免数据泄漏
class_x_tra, class_x_test, class_y_tra, class_y_test = train_test_split(
    X,
    y,
    test_size=0.3,
    random_state=2,
    stratify=y
)

class_x_tra = class_x_tra.copy()
class_x_test = class_x_test.copy()
X_all_scaled = X.copy()

scaler = MinMaxScaler()
class_x_tra[num_cols] = scaler.fit_transform(class_x_tra[num_cols])
class_x_test[num_cols] = scaler.transform(class_x_test[num_cols])
X_all_scaled[num_cols] = scaler.transform(X_all_scaled[num_cols])

# 最佳参数值
best_params = {
    'subsample': 1.0,
    'reg_lambda': 3,
    'reg_alpha': 1,
    'n_estimators': 50,
    'min_child_weight': 1,
    'max_depth': 3,
    'learning_rate': 0.5,
    'gamma': 0,
    'colsample_bytree': None
}

# 初始化并训练模型
model = XGBClassifier(
    use_label_encoder=False,
    eval_metric='auc',
    random_state=33,
    n_jobs=1,
    tree_method='hist',
    **best_params
)

model.fit(class_x_tra, class_y_tra)

# SHAP 解释器
explainer = shap.TreeExplainer(model)

def convert_shap_values(shap_values):
    if isinstance(shap_values, list):
        shap_values = shap_values[-1]
    shap_values = np.array(shap_values)
    if shap_values.ndim == 3:
        shap_values = shap_values[:, :, -1]
    return shap_values

def convert_expected_value(expected_value):
    if isinstance(expected_value, list):
        expected_value = expected_value[-1]
    if isinstance(expected_value, np.ndarray):
        expected_value = expected_value.reshape(-1)[-1]
    return expected_value

# 计算全样本 SHAP 值
shap_values = explainer.shap_values(X_all_scaled)
shap_values = convert_shap_values(shap_values)
expected_value = convert_expected_value(explainer.expected_value)

# 计算平均绝对 SHAP 值并排序
mean_abs_shap = np.mean(np.abs(shap_values), axis=0)
feature_order = np.argsort(mean_abs_shap)
sorted_features = X_all_scaled.columns[feature_order]
sorted_shap_values = shap_values[:, feature_order]

# 分组：转移 / 非转移
X_metastasis = X_all_scaled[y == 1]
X_non_metastasis = X_all_scaled[y == 0]

shap_values_metastasis = explainer.shap_values(X_metastasis)
shap_values_non_metastasis = explainer.shap_values(X_non_metastasis)

shap_values_metastasis = convert_shap_values(shap_values_metastasis)
shap_values_non_metastasis = convert_shap_values(shap_values_non_metastasis)

mean_shap_values_metastasis = np.abs(shap_values_metastasis).mean(axis=0)[feature_order]
mean_shap_values_non_metastasis = np.abs(shap_values_non_metastasis).mean(axis=0)[feature_order]

# 创建图形------------------------------------------------------------------条形图---------------------------------------------------------------
fig, ax = plt.subplots(figsize=(8, 6))
bar_width = 0.8
index = np.arange(len(sorted_features))

ax.barh(index, mean_shap_values_non_metastasis, bar_width, color='blue', label='Non-Metastasis (Prelaryngeal Lymph Node Metastasis=No)')
