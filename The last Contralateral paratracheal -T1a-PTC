            n_jobs=1,
            scoring='roc_auc',
            refit=True,
            random_state=33
        )
        grid_search.fit(class_x_tra, class_y_tra)

    except Exception as e:
        print(f"模型 {name} 失败: {e}")
        continue

    best_model_temp = grid_search.best_estimator_

