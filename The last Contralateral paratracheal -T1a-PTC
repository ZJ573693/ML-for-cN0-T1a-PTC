tp_all2 = np.sum((val_target2 == 1) & (val_all_predictions2 == 1))
fp_all2 = np.sum((val_target2 == 0) & (val_all_predictions2 == 1))

net_benefit_all2 = (tp_all2 / len(val_target2)) - (fp_all2 / len(val_target2)) * (thresholds / (1 - thresholds))
