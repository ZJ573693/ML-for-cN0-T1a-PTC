# PMRA实现
def pmra(models_results):
    pairwise_comparisons = list(itertools.combinations(models_results.keys(), 2))
    pmra_results = []

    for model_a, model_b in pairwise_comparisons:
        y_a = np.asarray(models_results[model_a], dtype=float)
        y_b = np.asarray(models_results[model_b], dtype=float)

        min_len = min(len(y_a), len(y_b))
        y_a = y_a[:min_len]
        y_b = y_b[:min_len]

        wins_a = np.sum(y_a > y_b)
        wins_b = np.sum(y_a < y_b)
        total_comparisons = len(y_a)

        prob_a_win = wins_a / total_comparisons
        prob_b_win = wins_b / total_comparisons

        compare_result = np.where(y_a > y_b, 1, 0)
        compare_gap = np.abs(y_a - y_b)

        valid_mask = np.isfinite(compare_result) & np.isfinite(compare_gap)
        compare_result = compare_result[valid_mask]
        compare_gap = compare_gap[valid_mask]

        if len(compare_result) == 0:
            wald_statistic = np.nan
            p_value = np.nan
        elif len(np.unique(compare_result)) < 2:
            wald_statistic = np.nan
            p_value = np.nan
        elif np.allclose(compare_gap, compare_gap[0]):
            wald_statistic = np.nan
            p_value = np.nan
        else:
            try:
                X = sm.add_constant(compare_gap.reshape(-1, 1), has_constant='add')
                model = sm.Logit(compare_result, X)
                result = model.fit(disp=False, maxiter=200)

                wald_statistic = float(result.wald_test_terms().table.loc['x1', 'statistic'])
                p_value = float(result.wald_test_terms().table.loc['x1', 'pvalue'])
            except Exception as e:
                print(f'Wald检验失败: {model_a} vs {model_b}, error={e}')
                wald_statistic = np.nan
                p_value = np.nan

        pmra_results.append({
            'model_a': model_a,
            'model_b': model_b,
            'prob_a_win': prob_a_win,
            'prob_b_win': prob_b_win,
            'wald_statistic': wald_statistic,
            'p_value': p_value
        })

    return pmra_results

# 计算PMRA
pmra_results = pmra(model_results)

# 胜率和p值矩阵生成
models = list(set([res['model_a'] for res in pmra_results] + [res['model_b'] for res in pmra_results]))
