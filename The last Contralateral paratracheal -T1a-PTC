          'reg_lambda': 0, 
          'reg_alpha': 0.01, 
          'n_estimators': 2000, 
          'min_child_weight': 1, 
          'max_depth': 5, 
          'learning_rate': 0.05, 
          'gamma': 5,
          'colsample_bytree': 1.0,'seed': 33}

