def get_prob(model, X):
    if hasattr(model, 'predict_proba'):
        return model.predict_proba(X)[:, 1]
    elif hasattr(model, 'decision_function'):
        raw_score = model.decision_function(X)
        raw_score = (raw_score - np.min(raw_score)) / (np.max(raw_score) - np.min(raw_score) + 1e-12)
        return raw_score
    else:
        raise ValueError(f"{model.__class__.__name__} 不支持 predict_proba 或 decision_function")

def calculate_metrics(y_true, y_prob, threshold=0.5):
    y_pred = (y_prob >= threshold).astype(int)

    cm = confusion_matrix(y_true, y_pred)
    tn, fp, fn, tp = cm.ravel()

    accuracy = accuracy_score(y_true, y_pred)
    auc = roc_auc_score(y_true, y_prob)
    precision = precision_score(y_true, y_pred, zero_division=0)
    recall = recall_score(y_true, y_pred, zero_division=0)
    f1 = f1_score(y_true, y_pred, zero_division=0)

    specificity = tn / (tn + fp) if (tn + fp) > 0 else 0
    sensitivity = recall
    npv = tn / (tn + fn) if (tn + fn) > 0 else 0
    ppv = tp / (tp + fp) if (tp + fp) > 0 else 0
    fpr = fp / (fp + tn) if (fp + tn) > 0 else 0

    rmse = np.sqrt(mean_squared_error(y_true, y_prob))
    r2 = r2_score(y_true, y_prob)
    mae = mean_absolute_error(y_true, y_prob)
    lift = average_precision_score(y_true, y_prob) / (np.mean(y_true) + 1e-12)
    brier = brier_score_loss(y_true, y_prob)
    kappa = cohen_kappa_score(y_true, y_pred)

    return {
        'Accuracy': accuracy,
        'AUC': auc,
        'Precision': precision,
        'Specificity': specificity,
        'Sensitivity': sensitivity,
        'Negative Predictive Value': npv,
        'Positive Predictive Value': ppv,
        'Recall': recall,
        'F1 Score': f1,
        'False Positive Rate': fpr,
